# ===== Cryo-floods 环境变量模板（复制为 .env 后填写）=====

# Flask 会话签名密钥（生产环境务必改为强随机值）
SECRET_KEY=请填写随机字符串

# 高德地图 API Key
AMAP_KEY=

# DeepSeek API（决策支持智能体）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 系统管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请修改默认密码

# 运行配置（可选）
# FLASK_CONFIG=production
# HOST=127.0.0.1
# PORT=5000
# 运维人员 / 访客 账号
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=请修改
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=请修改